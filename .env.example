# ==============================================================================
# CARA — Cost-Aware Autonomous Research & Report Agent Configuration
# ==============================================================================

# Application Execution Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-use-a-strong-random-secret

# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Hard Budget & Loop Limits (Cost-Aware Guardrails)
MAX_RESEARCH_ITERATIONS=3
MAX_MODEL_CALLS=10
MAX_TOOL_CALLS=20
MAX_TOKENS=15000
MAX_EXECUTION_TIME=120
MAX_PROVIDER_RETRIES=2

# Tool & Security Boundaries
ALLOWED_DOCUMENT_DIR=data/documents
URL_READER_TIMEOUT=15
URL_READER_MAX_BYTES=1048576

# Database & Cache (Default SQLite / In-Memory for Dev)
DATABASE_URL=sqlite:///./data/cara.db
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Session Management
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_TOKEN_TTL_HOURS=24
